                Text("Manage rent collection, payment dates and pending balances.")
                    .multilineTextAlignment(.center)
                    .foregroundColor(.secondary)

                paymentCard("Arun Kumar", "₹15,000", "Pending")
                paymentCard("Priya", "₹12,000", "Paid")
                paymentCard("Rahul", "₹20,000", "Pending")

                Spacer()
            }
            .padding()
            .navigationTitle("Payments")
        }
    }

    func paymentCard(
        _ tenant: String,
        _ amount: String,
        _ status: String
    ) -> some View {

        HStack {

            VStack(alignment: .leading) {
                Text(tenant).bold()
                Text(amount).foregroundColor(.blue)
            }

            Spacer()

            Text(status)
                .font(.caption)
